{
  "name": "five-in-row",
  "description": "五子棋",
  "author": "keep-deep-think",
  "license": "MIT",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "start": "chcp 65001 && vite",
    "server": "nodemon server/index.js",
    "build": "vue-tsc && vite build",
    "pack": "electron-builder",
    "release": "electron-builder --publish always",
    "preview": "vite preview",
    "build-icon": "electron-icon-builder --input=./public/icon.ico --output=build --flatten"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.3",
    "qs": "^6.12.3",
    "uuid": "^10.0.0",
    "vue": "^3.4.21",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.deepthinker.gomoku",
    "productName": "five-in-row",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "keep-deep-think",
        "repo": "five-in-row"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:keep-deep-think/five-in-row.git"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "cross-env": "^7.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "electron-updater": "^6.2.1",
    "less": "^4.2.0",
    "typescript": "5.4.5",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "1.8.27"
  },
  "main": "dist-electron/main.js"
}